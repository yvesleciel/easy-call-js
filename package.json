{
  "name": "easy-call-js",
  "version": "2.0.0",
  "description": "makes it easy to add video calls easily and JavaScript-enabled, regardless of the framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./angular": {
      "types": "./dist/angular/types/easy-call-js-angular.d.ts",
      "default": "./dist/angular/fesm2022/easy-call-js-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "build:core": "tsc",
    "build:angular": "ng-packagr -p src/angular/ng-package.json -c src/angular/tsconfig.lib.json",
    "build": "npm run build:core && npm run build:angular",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webrtc",
    "javascript",
    "frontend",
    "peer-to-peer",
    "angular"
  ],
  "author": "Yvan NGOUDJOU",
  "license": "Apache-2.0",
  "sideEffects": false,
  "dependencies": {
    "firebase": "^10.13.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/common": ">=18",
    "@angular/core": ">=18"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^21.2.21",
    "@angular/compiler": "^21.2.21",
    "@angular/compiler-cli": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@types/jest": "^30.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.4.1",
    "ng-packagr": "^21.2.7",
    "ts-jest": "^29.4.4",
    "typescript": "^5.6.3"
  }
}
